#!/usr/bin/env python
# 触音律动 audio_analyzer GDExtension 构建
# 用法: 在本目录执行 python -m SCons platform=windows target=template_debug arch=x86_64
# 或直接运行上级目录的 build_addon.bat
import os

# godot-cpp 位置: 环境变量 GODOT_CPP 优先, 默认本机工具链目录
godot_cpp = os.environ.get("GODOT_CPP", r"E:/build_tools/godot-cpp-4.5")

env = SConscript(os.path.join(godot_cpp, "SConstruct"))

# src = 封装代码, .. = analyzer_core.hpp/cpp, ../third_party = minimp3
env.Append(CPPPATH=["src", "..", "../third_party"])
if env["platform"] == "windows":
	env.Append(CXXFLAGS=["/utf-8"])

sources = Glob("src/*.cpp") + Glob("../analyzer_core.cpp")

if env["platform"] == "macos":
	library = env.SharedLibrary(
		"bin/libaudio_analyzer.{}.{}.framework/libaudio_analyzer.{}.{}".format(
			env["platform"], env["target"], env["platform"], env["target"]),
		source=sources,
	)
else:
	library = env.SharedLibrary(
		"bin/libaudio_analyzer{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
		source=sources,
	)
Default(library)
